# ==========================================
# Dependencies
# ==========================================
node_modules/
**/node_modules/
vendor/
**/vendor/

# ==========================================
# Environment & Sensitive Files
# ==========================================
.env
.env.*
.env.local
.env.production
.env.backup
.env.stage
**/.env
**/.env.*
**/.env.local
**/.env.production
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.pfx
*.cer
*.crt
*.id_rsa
auth.json
**/auth.json

# ==========================================
# Databases & SQLite
# ==========================================
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
**/database.sqlite
**/database/*.sqlite*

# ==========================================
# Logs & Debugging
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/storage/logs/*
!**/storage/logs/.gitignore
!**/storage/logs/.gitkeep

# ==========================================
# PHPUnit & Testing Caches
# ==========================================
.phpunit.result.cache
**/.phpunit.result.cache
.phpunit.cache
**/.phpunit.cache

# ==========================================
# Laravel Framework Caches & Storage
# ==========================================
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
backend/.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml

# ==========================================
# Frontend Build Artifacts
# ==========================================
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# ==========================================
# Operating System & IDE Files
# ==========================================
.DS_Store
Thumbs.db
.idea/
**/.idea/
.vscode/*
!.vscode/extensions.json
**/.vscode/*
!**/.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
